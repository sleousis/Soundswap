<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Everything that decides anything lives here: no Dalamud, no game types, no ImGui. It is what the
    tests cover, and it is what keeps working when the game patches.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Soundswap.Core</RootNamespace>
    <AssemblyName>Soundswap.Core</AssemblyName>
  </PropertyGroup>
</Project>
